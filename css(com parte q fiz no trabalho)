/* ----- FONTES ----- */

@font-face {
    font-family: 'Handodle';
    src: url('../fonts/CabinSketch-Regular.ttf') format('truetype');
}

@font-face {
    font-family: 'Redrum';
    src: url('./assets/fonts/Redrum.ttf') format('truetype');
}

@font-face {
    font-family: 'CabinSketch';
    src: url('../fonts/CabinSketch-Regular.ttf') format('truetype');
}

/* ----- banner padrao fundo ----- */
body {
    background-image: url('../img/fundo.svg');
}

/* ----- HEADER ------ */
.header {
    background-color: #ECA2FF;
    display: flex;
    justify-content: space-between;
    padding: 10px 40px;
}

/* menu principal */
.menu {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 30px;
    margin-top: 20px;
    margin-right: 20px;
    background-color: #ffffff;
    border-radius: 30px;
    padding: 10px 20px;
}

/* links do menu */
.menu a {
    display: block;
    text-decoration: none;
    color: #000;
    padding: 10px;
}

/* cada item do menu */
.menu li {
    position: relative;
}

/* submenu */
.submenu {
    display:none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 170px;
    list-style: none;
    margin: 0;
    background-color: #FFFFFF;
    border-radius: 10px;
    padding: 0;
}

/* mostrar o submenu quando passa o mouse */
.menuRotina:hover
.submenu {
    display: block;
}

/* deixar o botao todo clicavel */
.submenu li a {
    display: block;
    padding: 12px 16px;
}

/* quando passa o mouse nos botoes */
.submenu li a:hover {
    background-color: #E4D7FF;
    border-radius: 10px;
}

/* ----- FOOTER ----- */
.footer {
    background-color: #ECA2FF;
}

/* ----- PAGINA INICIO ----- */
.paginaInicio {
    display: flex;
}

.nomeSerena {
    font-family: 'Redrum', sans-serif;
}
